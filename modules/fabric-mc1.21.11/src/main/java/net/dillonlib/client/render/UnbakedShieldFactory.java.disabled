package net.dillonlib.client.render;

import com.mojang.serialization.Codec;
import com.mojang.serialization.MapCodec;
import com.mojang.serialization.codecs.RecordCodecBuilder;
import net.dillonlib.annotation.PrivateUse;
import net.minecraft.client.render.entity.model.EntityModelLayers;
import net.minecraft.client.render.entity.model.ShieldEntityModel;
import net.minecraft.client.render.item.model.special.SpecialModelRenderer;
import net.minecraft.client.util.SpriteIdentifier;
import net.minecraft.util.Identifier;

/**
 * Creates a {@code shield factory unbaked renderer.}
 */
@PrivateUse
public class UnbakedShieldFactory implements SpecialModelRenderer.Unbaked {
    private final SpriteIdentifier base;
    private final SpriteIdentifier baseNoPattern;

    public static final Codec<SpriteIdentifier> SPRITE_IDENTIFIER_CODEC = RecordCodecBuilder.create(instance -> instance.group(
            Identifier.CODEC.fieldOf("atlas_id").forGetter(SpriteIdentifier::getAtlasId),
            Identifier.CODEC.fieldOf("texture_id").forGetter(SpriteIdentifier::getTextureId)
    ).apply(instance, SpriteIdentifier::new));

    public static final MapCodec<UnbakedShieldFactory> CODEC = RecordCodecBuilder.mapCodec(instance -> instance.group(
            SPRITE_IDENTIFIER_CODEC.fieldOf("base").forGetter(UnbakedShieldFactory::getBaseSpriteIdentifier),
            SPRITE_IDENTIFIER_CODEC.fieldOf("base_no_pattern").forGetter(UnbakedShieldFactory::getBaseNoPatternSpriteIdentifier)
    ).apply(instance, UnbakedShieldFactory::new));

    public UnbakedShieldFactory(SpriteIdentifier base, SpriteIdentifier baseNoPattern) {
        this.base = base;
        this.baseNoPattern = baseNoPattern;
    }

    private SpriteIdentifier getBaseSpriteIdentifier() {
        return this.base;
    }

    private SpriteIdentifier getBaseNoPatternSpriteIdentifier() {
        return this.baseNoPattern;
    }

    @Override
    public MapCodec<UnbakedShieldFactory> getCodec() {
        return CODEC;
    }

    @Override
    public SpecialModelRenderer<?> bake(SpecialModelRenderer.BakeContext context) {
        return new AbstractShieldModelRenderer(context.spriteHolder(), new ShieldEntityModel(context.entityModelSet().getModelPart(EntityModelLayers.SHIELD))) {
            @Override
            protected SpriteIdentifier getBaseSprite() {
                return UnbakedShieldFactory.this.base;
            }

            @Override
            protected SpriteIdentifier getBaseNoPatternSprite() {
                return UnbakedShieldFactory.this.baseNoPattern;
            }
        };
    }
}